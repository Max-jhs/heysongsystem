    <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="userMap">
        <!--@mbg.generated-->
        SELECT
        t1.*,
        t2.id AS editIid,
        t2.NAME AS editByPO,
        t3.id AS creatId,
        t3.NAME AS createByPO
        FROM
        t_user t1
        LEFT JOIN t_user t2 ON t1.edit_by = t2.id
        LEFT JOIN t_user t3 ON t1.create_by = t3.id
        WHERE
        t1.id = #{id}
    </select>
