    <!--  根据用户id查询用户角色-->
    <select id="selectUserRole" resultType="java.lang.String">
        select r.role
        from t_user_role ur
                 left join t_role r on ur.role_id = r.id
        where ur.user_id = #{loginId}
    </select>
    <!--  根据用户id查询权限信息-->
    <select id="selectPermission" resultType="java.lang.String">
        select p.code
        from t_user_role as ur
                 left join t_role as r on ur.role_id = r.id
                 left join t_role_permission as rp on r.id = rp.role_id
                 left join t_permission as p on rp.permission_id = p.id
        where ur.user_id = #{loginId}
    </select>


