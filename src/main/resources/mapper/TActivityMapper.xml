  <select id="selectAll" parameterType="com.heysong.model.query.ActivityQuery" resultMap="activityMap">

      select a.*,u.id uid,u.name uname
      from t_activity a
      left join t_user u on a.owner_id = u.id
        <where>
            <if test="ownerId != '' and ownerId != null">
                and a.owner_Id = #{ownerId}
            </if>
            <if test="cost != '' and cost != null">
                and a.cost = #{cost}
            </if>
            <if test="createTime != null">
                and a.create_time = #{createTime}
            </if>
            <!--模糊查询活动名字-->
            <if test="name != '' and name != null">
                and a.name like concat("%",#{name},"%")
            </if>
            <!--只有开始时间-->
            <if test="(startTime != null ) and (endTime == null)">
                and a.start_time &gt;= #{startTime}
            </if>
            <!--只有结束时间使用cdata-->
            <if test="(startTime == null ) and (endTime != null)">
                <![CDATA[
                    and a.end_time &lt;= #{endTime}
                ]]>
            </if>
            <!--之间时间-->
            <if test="(startTime != null) and (endTime != null)">
                and a.start_time &gt;= #{startTime} and a.end_tmie &lt;= #{endTime}
            </if>
            <!-- 没有时间限制 -->
            <!-- 拼接增强sql$  不能使用#{} 占位符?-->
            ${dySql}
        </where>
    </select>

