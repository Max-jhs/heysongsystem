      owner.name oname,
      c.id cid,
      c.name cname,
      e.id eid,
      e.name ename
      from
      t_activity t
      left join
      t_user owner
      on t.owner_id = owner.id
      left join
      t_user c
      on t.create_by = c.id
      left join
      t_user e
      on t.edit_by = e.id
      where
      t.id = #{id}

  </select>
